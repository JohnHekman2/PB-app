# --- 1. GLOBAL IGNORE ---

# --- 2. TRAVERSAL ---
# Un-ignore directories so Git can look inside them to find .py files
!*/

# --- 3. EXPLICIT BLOCKS (SAFETY) ---
# Explicitly block these folders 
# to ensure no traversal happens and no accidents occur.
__pycache__/
.streamlit/
vector_store/
.venv/
.vscode/
venv/
.env

# --- 4. THE WHITELIST (WHAT TO KEEP) ---
# Un-ignore (Track) all Python script files
!*.py

# Un-ignore this .gitignore file itself (so it is tracked)
!.gitignore

# Optional: Un-ignore requirements.txt (Highly recommended to track this too)
!requirements.txt
